rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'kimtrong16490@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isTeacherOrAdmin() {
      return isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isBootstrappedAdmin());
      allow delete: if isAdmin() || isBootstrappedAdmin();
    }

    // 2. Classes (Lớp học)
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin() || isBootstrappedAdmin();
    }

    // 3. Students (Học sinh)
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin() || isBootstrappedAdmin();
    }

    // 4. Teachers (Giáo viên)
    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isBootstrappedAdmin();
    }

    // 5. Subjects (Môn học)
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin() || isBootstrappedAdmin();
    }

    // 6. Grades (Sổ điểm & Đánh giá)
    match /grades/{gradeId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin() || isBootstrappedAdmin();
    }

    // 7. Attendance (Điểm danh chuyên cần)
    match /attendance/{recordId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin() || isBootstrappedAdmin();
    }

    // 8. Question Bank (Ngân hàng câu hỏi)
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 9. Assignments (Bài tập)
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin() || isBootstrappedAdmin();
    }

    // 10. Submissions (Bài nộp học sinh)
    match /submissions/{submissionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 11. Announcements (Bảng tin & Thông báo)
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin() || isBootstrappedAdmin();
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }
  }
}
